#!/usr/bin/env sh
# Husky pre-commit hook — runs lint-staged on changed files + a sanity
# typecheck on the affected workspaces.
#
# Per the Round-5 plan: this complements (not replaces) the project's
# .claude/hooks/format-and-lint.sh and typecheck-affected.sh — those
# fire only inside Claude Code sessions. This hook covers every other
# contributor (CLI, IDE, GitHub web edits via clone, etc.) so the
# discipline doesn't depend on a single tool.
#
# Critical invariants (CLAUDE.md NEVER list):
#   - NEVER pass --no-verify; this hook is load-bearing for HIPAA + SSH
#     signing discipline
#   - NEVER skip lint-staged; PHI sanitizer + a11y rules + ban-direct-
#     vendor-SDK-imports rules ALL run via ESLint at this layer
#
# Node version pinning: the project pins Node 24 LTS in `engines`. If
# the workstation has multiple Node versions installed (e.g., Homebrew
# default is Node 25), prefer the Cellar path for node@24 when present
# so the hook fires against the same Node version CI uses. Caller can
# always override by exporting PATH before `git commit`.
if [ -d "/opt/homebrew/opt/node@24/bin" ]; then
  export PATH="/opt/homebrew/opt/node@24/bin:$PATH"
fi
set -e
pnpm exec lint-staged
# Full-graph typecheck at M1 — one workspace (`apps/web`) keeps this fast
# (~3-5s warm cache). When the monorepo grows past 2 workspaces (likely
# packages/ui at the D69 extraction trigger), switch to
# `pnpm exec turbo run typecheck --affected` per Turbo 2.x docs.
pnpm typecheck
