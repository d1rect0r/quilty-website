#!/usr/bin/env sh
# Husky commit-msg hook — Conventional Commits enforcement via
# @commitlint/cli + @commitlint/config-conventional.
#
# Convention per CLAUDE.md "Git conventions" — atomic commits with one
# of: feat / fix / refactor / docs / test / chore / style + perf / build
# / ci / revert + an optional scope in parens.
#
# commitlint replaces the prior regex-only check — config in
# commitlint.config.mjs at repo root. Merge / revert / fixup / squash
# commits bypass per commitlint's defaults.

# Use Node 24 if available (matches CI; engines field requires it).
if [ -d "/opt/homebrew/opt/node@24/bin" ]; then
  export PATH="/opt/homebrew/opt/node@24/bin:$PATH"
fi

pnpm exec commitlint --edit "$1"
