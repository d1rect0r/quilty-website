{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Quilty public website — Next.js 16 App Router + TypeScript strict.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "velite build --config ../../velite.config.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib instrumentation.ts proxy.ts sentry.client.config.ts sentry.server.config.ts sentry.edge.config.ts next.config.ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "playwright test --grep @a11y",
    "test:e2e": "playwright test",
    "clean": "rm -rf .next .turbo .velite *.tsbuildinfo"
  },
  "dependencies": {
    "next": "16.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "next-intl": "4.12.0",
    "lucide-react": "0.460.0",
    "clsx": "2.1.1",
    "class-variance-authority": "0.7.1",
    "tailwind-merge": "2.6.0",
    "@sentry/nextjs": "10.53.1",
    "@vercel/otel": "2.1.2",
    "web-vitals": "4.2.4",
    "server-only": "0.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "tailwindcss": "4.3.0",
    "@tailwindcss/postcss": "4.3.0",
    "postcss": "8.5.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8",
    "@vitejs/plugin-react": "4.3.4",
    "@testing-library/react": "16.1.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/user-event": "14.5.2",
    "jsdom": "25.0.1",
    "@playwright/test": "1.60.0",
    "@axe-core/playwright": "4.10.2"
  }
}
