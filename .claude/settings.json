      "Bash(pnpm format:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm install -r:*)",
      "Bash(pnpm i)",
      "Bash(pnpm i --frozen-lockfile)",
      "Bash(pnpm --filter * lint:*)",
      "Bash(pnpm --filter * typecheck:*)",
      "Bash(pnpm --filter * test:*)",
      "Bash(pnpm --filter * build:*)",
      "Bash(pnpm --filter * dev:*)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec playwright *)",
      "Bash(pnpm exec next *)",
      "Bash(pnpm exec shadcn *)",
      "Bash(pnpm sst dev *)",
      "Bash(pnpm sst diff *)",
      "Bash(pnpm sst secret list *)",
      "Bash(sst dev *)",
      "Bash(sst diff *)",
      "Bash(sst secret list *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git merge-base:*)",
      "Bash(git config --get *)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh api:*)",
      "Bash(gh auth status)",
      "Bash(gh ssh-key list)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(jq:*)",
      "Bash(tree:*)",
      "Bash(which:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(comm:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(find . *)",
      "Bash(mkdir -p:*)",
      "Bash(touch:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(make:*)",
      "Bash(npx @axe-core/cli *)",
      "Bash(npx @axe-core/playwright *)",
      "Bash(npx lighthouse *)",
      "Bash(npx -y @playwright/mcp@latest)",
      "Bash(aws sso login *)",
      "Bash(aws sso logout *)",
      "Bash(aws sts get-caller-identity *)",
      "Bash(aws ssm get-parameter *)",
      "Bash(aws ssm describe-parameters *)",
      "Bash(aws ssm list-parameters *)",
      "Bash(aws cloudformation describe-stacks *)",
      "Bash(aws cloudformation list-stacks *)",
      "Bash(aws s3 ls *)",
      "Bash(aws iam get-role *)",
      "Bash(aws iam list-role-policies *)",
      "Bash(aws acm list-certificates *)",
      "Bash(aws acm describe-certificate *)",
      "Bash(aws route53 list-hosted-zones *)",
      "Bash(dig:*)",
      "Bash(host:*)",
      "Bash(whois:*)",
      "Bash(nslookup:*)",
      "Bash(curl -sI *)",
      "Bash(curl -sLI *)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:sst.dev)",
      "WebFetch(domain:opennext.js.org)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:lucide.dev)",
      "WebFetch(domain:turbo.build)",
      "WebFetch(domain:pnpm.io)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:dequeuniversity.com)",
      "WebFetch(domain:next-intl.dev)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:docs.sentry.io)",
      "WebFetch(domain:amplitude.com)",
      "WebFetch(domain:docs.stripe.com)",
      "WebFetch(domain:web.dev)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:www.w3.org)",
      "WebFetch(domain:owasp.org)",
      "WebFetch(domain:hhs.gov)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git push --force-with-lease *)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git pull --rebase:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git tag:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh workflow run:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm update:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm verify:*)",
      "Bash(pnpm verify)",
      "Bash(pnpm syncpack:*)",
      "Bash(pnpm knip:*)",
      "Bash(pnpm depcruise:*)",
      "Bash(pnpm size:*)",
      "Bash(pnpm type-coverage:*)",
      "Bash(pnpm exec turbo:*)",
      "Bash(turbo:*)",
      "Bash(pnpm --filter:*)"
    ],
    "ask": [
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(sst deploy *)",
      "Bash(pnpm sst deploy *)",
      "Bash(pnpm sst secret set *)",
      "Bash(sst secret set *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/secrets/**)",
      "Read(./**/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~ *)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME *)",
      "Bash(rm -rf .git)",
      "Bash(rm -rf .git *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard origin *)",
      "Bash(git reset --hard HEAD~*)",
      "Bash(git push origin master)",
      "Bash(git push origin master *)",
      "Bash(git push origin production)",
      "Bash(git push origin production *)",
      "Bash(git config * commit.gpgsign *)",
      "Bash(git config * user.signingkey *)",
      "Bash(sst remove)",
      "Bash(sst remove *)",
      "Bash(pnpm sst remove)",
      "Bash(pnpm sst remove *)",
      "Bash(sst deploy --stage prod *)",
      "Bash(sst deploy --stage production *)",
      "Bash(pnpm sst deploy --stage prod *)",
      "Bash(pnpm sst deploy --stage production *)",
      "Bash(aws * delete *)",
      "Bash(aws s3 rb *)",
      "Bash(aws s3 rb)",
      "Bash(aws rds delete *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(npm install -g *)",
      "Bash(npm install -g:*)"
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-write.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-and-lint.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/typecheck-affected.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-prompt.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_PROJECT_DIR}/.claude/statusline.sh",
    "padding": 1,
    "refreshInterval": 5
  },
  "cleanupPeriodDays": 60,
  "includeCoAuthoredBy": false,
  "autoMemoryEnabled": true
}
