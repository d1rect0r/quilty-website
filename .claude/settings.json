{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(./**)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm test:unit:*)",
      "Bash(pnpm test:e2e:*)",
      "Bash(pnpm test:a11y:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm --filter * lint:*)",
      "Bash(pnpm --filter * typecheck:*)",
      "Bash(pnpm --filter * test:*)",
      "Bash(pnpm --filter * build:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm exec playwright:*)",
      "Bash(pnpm sst dev:*)",
      "Bash(pnpm sst diff:*)",
      "Bash(pnpm sst secret list:*)",
      "Bash(sst dev:*)",
      "Bash(sst diff:*)",
      "Bash(sst secret list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh api:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(jq:*)",
      "Bash(tree:*)",
      "Bash(which:*)",
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(npx:*)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:sst.dev)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:typescriptlang.org)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:opennext.js.org)",
      "WebFetch(domain:docs.sentry.io)",
      "WebFetch(domain:amplitude.com)",
      "WebFetch(domain:docs.stripe.com)",
      "WebFetch(domain:web.dev)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:www.w3.org)",
      "WebFetch(domain:owasp.org)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(sst deploy:*)",
      "Bash(pnpm sst deploy:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm update:*)",
      "Bash(npm install -g:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/secrets/**)",
      "Read(./**/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf .git:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force:*)",
      "Bash(git push * -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit * --no-verify:*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit * --no-gpg-sign:*)",
      "Bash(git commit *--no-gpg-sign*)",
      "Bash(git reset --hard origin*)",
      "Bash(git reset --hard HEAD~*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin production:*)",
      "Bash(sst remove:*)",
      "Bash(pnpm sst remove:*)",
      "Bash(sst deploy --stage prod*)",
      "Bash(sst deploy --stage production*)",
      "Bash(pnpm sst deploy --stage prod*)",
      "Bash(pnpm sst deploy --stage production*)",
      "Bash(aws * delete*)",
      "Bash(aws s3 rb:*)",
      "Bash(aws rds delete*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)"
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-and-lint.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/typecheck-affected.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${CLAUDE_PROJECT_DIR}/.claude/statusline.sh",
    "padding": 1
  },
  "cleanupPeriodDays": 60,
  "includeCoAuthoredBy": false
}
