# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Node / pnpm
node_modules/
.pnpm-store/
pnpm-debug.log*

# Env files (NEVER commit real secrets)
.env
.env.*
!.env.example
!.env.*.example
*.local
.dev.vars

# Next.js
.next/
out/
next-env.d.ts
.swc/
.cache/
.next/analyze/
analyze/

# Vercel / Netlify (foot-guns even though we deploy via SST)
.vercel/
.netlify/

# Turborepo
.turbo/

# SST 4.x (Ion engine, Pulumi underneath)
.sst/
.open-next/
# Generated per-workspace by `sst dev`/`sst deploy` (SST resource-linking
# types). No code uses `Resource.*` linking — config flows via env vars — so
# the files carry no value on a fresh checkout; ignored rather than committed.
# Revisit (commit them, per SST's docs suggestion) if linking is ever adopted.
sst-env.d.ts

# Velite (content layer compiler — emits to .velite/ at apps/web/)
.velite/

# Build outputs
dist/
build/
*.tsbuildinfo

# @quilty/tokens publishes its generated CSS via the package `exports`
# field; the file MUST exist at install time for apps/web to resolve
# the `@import '@quilty/tokens/globals.css'` directive in fresh checkouts.
# Drift between this committed artifact and the JSON sources is caught
# by `packages/tokens/__tests__/byte-identical.test.ts`.
!packages/tokens/dist/
!packages/tokens/dist/**

# Workbox runtime bundles vendored at build time by
# `apps/web/scripts/vendor-workbox.mjs` (runs in apps/web's prebuild
# step). NOT committed because the source-of-truth is the
# `workbox-*` npm packages pinned in apps/web/package.json — a fresh
# clone runs `pnpm install` then `pnpm build` and the vendor script
# repopulates the directory.
apps/web/public/workbox/

# OpenAPI codegen target (regenerated from Rust backend via
# `node apps/web/scripts/codegen-api-types.mjs`). The generated files
# ARE committed to source so the workspace stays self-contained at
# every checkout — matches the @quilty/shared-types/src/index.ts
# docstring. CI cannot run codegen because the OpenAPI spec lives in
# the sibling `quilty-aws` repo which is not vended here. When the
# codegen-CI publish pipeline activates (ADR-0003 trigger), this
# ignore can be reintroduced and the publish step takes over.
# packages/shared-types/src/generated/

# Test artifacts
coverage/
playwright-report/
test-results/
.lighthouseci/

# Storybook (if added)
storybook-static/

# Sentry CLI auth
.sentryclirc

# AWS SSO cache (in case anyone runs aws CLI locally)
.aws-sso/

# Logs
*.log
logs/

# Claude Code — local-only state
.claude/settings.local.json
.claude/.credentials.json
.claude/projects/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/sst-audit.log
