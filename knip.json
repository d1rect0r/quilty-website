{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["velite.config.ts", "turbo/generators/config.ts"],
      "project": ["*.ts", "*.mjs", "turbo/generators/**/*.ts"],
      "ignoreDependencies": [
        "eslint-import-resolver-typescript",
        "eslint-plugin-import",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-react-hooks",
        "@secretlint/secretlint-rule-preset-recommend",
        "csp_evaluator"
      ],
      "ignoreBinaries": ["dot"]
    },
    "apps/web": {
      "entry": [
        "app/**/{page,layout,loading,error,not-found,template,default,route,global-error}.{ts,tsx}",
        "app/{robots,sitemap,manifest,opengraph-image,twitter-image,icon,apple-icon}.{ts,tsx}",
        "sentry.{client,server,edge}.config.ts",
        "composition.{server,client,edge}.ts",
        "scripts/**/*.mjs",
        "tests/playwright/global-{setup,teardown}.ts",
        "tests/playwright/**/*.spec.ts"
      ],
      "project": [
        "app/**/*.{ts,tsx}",
        "components/**/*.{ts,tsx}",
        "lib/**/*.{ts,tsx}",
        "scripts/**/*.mjs",
        "tests/**/*.{ts,tsx}"
      ],
      "ignore": [
        "lib/flags/features.ts",
        "lib/utils.ts",
        "lib/toast.ts",
        "components/site/InstallPrompt.tsx",
        "components/site/IOSCoachMark.tsx"
      ],
      "ignoreDependencies": [
        "class-variance-authority",
        "clsx",
        "lucide-react",
        "next-intl",
        "tailwind-merge",
        "web-vitals",
        "tailwindcss",
        "@quilty/content",
        "@quilty/shared-types",
        "@quilty/tokens",
        "openapi-typescript",
        "workbox-core",
        "workbox-expiration",
        "workbox-precaching",
        "workbox-routing",
        "workbox-strategies",
        "workbox-sw"
      ]
    }
  }
}
