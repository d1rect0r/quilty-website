# Default to LF line endings; Git will normalize on commit + checkout.
* text=auto eol=lf

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.xml text eol=lf

# Generated lockfiles — never merge by hand
pnpm-lock.yaml -diff merge=binary
package-lock.json -diff merge=binary
yarn.lock -diff merge=binary

# Binary types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary
*.mp4 binary
*.webm binary

# Documentation
*.txt text eol=lf
LICENSE text eol=lf
README* text eol=lf
CHANGELOG* text eol=lf

# Shell scripts must keep LF (Windows CRLF breaks them on macOS/Linux)
*.sh text eol=lf

# .well-known files (Apple App Site Association, Android assetlinks)
# — load-bearing for mobile deeplink verification; must NEVER get CRLF
# corruption on Windows checkouts. AASA has no .json extension so we
# need explicit text+LF declaration.
.well-known/* text eol=lf

# Extra binary types Next.js / Velite / SWC may emit
*.wasm binary
*.node binary
*.tar binary
*.tgz binary
