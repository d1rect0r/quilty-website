{
  "name": "@quilty/email",
  "version": "0.1.0",
  "description": "Transactional email surface — EmailSender port + in-memory adapter (production-grade) + SES adapter skeleton (typed-throwing until sandbox-lift). Zero PHI in email content per D31.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quilty/security": "workspace:*",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.4.0",
    "react": "^19.0.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "jsdom": "25.0.1",
    "typescript": "^5.7.2",
    "vitest": "2.1.8"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "sideEffects": [
    "./src/index.ts"
  ]
}
