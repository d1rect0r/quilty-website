{
  "name": "@quilty/captcha",
  "version": "0.1.0",
  "description": "CAPTCHA verifier — Verifier port + always-pass in-memory adapter (test fake + pre-activation production) + Turnstile adapter skeleton (typed-throwing until BAA + secret provisioning).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "2.1.8",
    "typescript": "^5.7.2",
    "vitest": "2.1.8"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "sideEffects": [
    "./src/index.ts"
  ]
}
