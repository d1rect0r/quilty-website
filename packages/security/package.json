{
  "name": "@quilty/security",
  "version": "0.1.0",
  "description": "PHI sanitizer + CSP + security headers + redirect validator + forms primitives (CSRF, honeypot, time-trap stubs).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "2.1.8",
    "csp_evaluator": "^1.1.5",
    "typescript": "^5.7.2",
    "vitest": "2.1.8"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "sideEffects": false
}
