{
  "name": "@quilty/rate-limit",
  "version": "0.1.0",
  "description": "Rate limiter — sliding-window port + in-memory adapter (production at M1.5; auth-adjacent paths) + DynamoDB adapter skeleton (typed-throwing until table provisioning).",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/__fakes__/index.ts",
      "default": "./src/__fakes__/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "2.1.8",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
