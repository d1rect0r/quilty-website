{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "rootDir": ".",
    "outDir": ".tsbuildcache",
    "noEmit": true,
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
