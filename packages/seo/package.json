{
  "name": "@quilty/seo",
  "version": "0.1.0",
  "description": "SEO + structured-data builders (Organization / WebSite / SoftwareApplication / Breadcrumb / MedicalWebPage / FAQPage) + JsonLd component + Next.js metadata helpers.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "jsdom": "25.0.1",
    "next": "16.2.0",
    "react": "^19.0.0",
    "react-dom": "19.0.0",
    "typescript": "^5.7.2",
    "vitest": "2.1.8"
  },
  "peerDependencies": {
    "next": "16.2.0",
    "react": "^19.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false
}
