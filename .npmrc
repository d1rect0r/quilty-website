# pnpm settings — see Round-5 audit (docs/research/round_5_independent_review/02-monorepo-tooling.md).

# Strict peer-dep resolution: surfaces version mismatches at install time rather than
# at runtime. Pairs with strict-peer-dependencies.
auto-install-peers=true
strict-peer-dependencies=true

# pnpm 10 best practice (Cal.com March 2026): deduplicate peer-dep instances
# across workspaces to avoid bundle bloat in Lambda outputs.
dedupe-peer-dependents=true

# Enforce Node + pnpm version pins declared in root package.json `engines`.
# Without this, pnpm only warns on version mismatch instead of refusing the
# install — for HIPAA-aligned + reproducible-build properties, fail-fast wins.
engine-strict=true

# Disk-efficient install: pnpm hardlinks from the global content-addressable store.
# Reduces node_modules disk usage 60-80% vs npm/yarn.
package-import-method=hardlink

# Lifecycle scripts (next-build, husky-install, etc.) — only from explicitly
# allowed packages. Default allowlist is empty; pnpm prompts on first install.
enable-pre-post-scripts=false

# Lockfile discipline:
# - frozen-lockfile is enforced in CI via `pnpm install --frozen-lockfile`.
# - shamefully-hoist is intentionally false (default) to keep node_modules flat;
#   bad hoisting masks missing dependencies that fail in production builds.

# Resolution strictness:
resolution-mode=highest
save-exact=true

# verify-store-integrity is true by default — keeps content-addressable store honest.
