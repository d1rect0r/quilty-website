{
  "name": "quilty-website",
  "version": "0.1.0",
  "private": true,
  "description": "Quilty's public-facing website — Turborepo + pnpm monorepo.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:a11y": "turbo run test:a11y",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,mdx,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,mdx,css,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky",
    "sst:dev": "sst dev --stage dev",
    "sst:diff": "sst diff --stage dev",
    "sst:secret:list": "sst secret list --stage dev"
  },
  "devDependencies": {
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.9.0",
    "typescript": "^5.7.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.0",
    "typescript-eslint": "^8.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "@eslint/js": "^9.17.0",
    "sst": "^4.14.1"
  }
}
