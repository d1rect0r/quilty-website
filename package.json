{
  "name": "quilty-website",
  "version": "0.1.0",
  "description": "Quilty's public-facing website — Turborepo + pnpm monorepo.",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "compliance-language:check": "node scripts/check-compliance-language.mjs",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "depcruise:graph": "depcruise apps packages --config .dependency-cruiser.cjs --output-type dot | dot -T svg > dependency-graph.svg",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,mdx,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,mdx,css,yml,yaml}\"",
    "knip": "knip --no-progress --include files,dependencies,unlisted,binaries",
    "knip:fix": "knip --no-progress --fix",
    "knip:full": "knip --no-progress",
    "lhci": "lhci autorun --config=.lighthouserc.json",
    "lint": "turbo run lint",
    "prepare": "husky",
    "secretlint": "secretlint --secretlintrc .secretlintrc.json --secretlintignore .secretlintignore '**/*' --maskSecrets",
    "security-txt:check": "node scripts/check-security-txt-expires.mjs",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "sst:dev": "sst dev --stage dev",
    "sst:diff": "sst diff --stage dev",
    "sst:secret:list": "sst secret list --stage dev",
    "start": "turbo run start",
    "syncpack:fix": "syncpack fix-mismatches && syncpack format",
    "syncpack:lint": "syncpack lint",
    "test": "turbo run test",
    "test:a11y": "turbo run test:a11y",
    "test:e2e": "turbo run test:e2e",
    "type-coverage": "type-coverage",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm syncpack:lint && pnpm knip && pnpm depcruise && pnpm security-txt:check && pnpm compliance-language:check && pnpm workflow-context:check && pnpm typecheck && pnpm lint && pnpm test && pnpm type-coverage && pnpm format:check && pnpm secretlint",
    "workflow-context:check": "node scripts/check-no-workflow-context.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.17.0",
    "@lhci/cli": "0.15.1",
    "@quilty/content": "workspace:*",
    "@secretlint/secretlint-rule-preset-recommend": "^11.7.1",
    "@size-limit/file": "12.1.0",
    "@size-limit/preset-app": "12.1.0",
    "@turbo/gen": "2.9.14",
    "csp_evaluator": "^1.1.5",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^15.2.10",
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "secretlint": "^11.7.1",
    "size-limit": "12.1.0",
    "sst": "^4.14.1",
    "syncpack": "^13.0.4",
    "turbo": "2.9.14",
    "type-coverage": "^2.29.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "velite": "0.2.1"
  },
  "license": "UNLICENSED",
  "pnpm": {
    "overrides": {
      "@opentelemetry/api-logs": "^0.218.0",
      "@opentelemetry/sdk-logs": "^0.218.0",
      "@opentelemetry/instrumentation": "^0.218.0",
      "@opentelemetry/sdk-metrics": "^2.7.1",
      "@opentelemetry/sdk-trace-base": "^2.7.1",
      "@opentelemetry/resources": "^2.7.1",
      "@opentelemetry/core": "^2.7.1",
      "sharp": "^0.34.5"
    }
  },
  "typeCoverage": {
    "atLeast": 97,
    "strict": true,
    "detail": false,
    "ignoreCatch": true,
    "ignoreFiles": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "tests/**",
      "**/__tests__/**",
      "sst.config.ts",
      "velite.config.ts"
    ]
  }
}
